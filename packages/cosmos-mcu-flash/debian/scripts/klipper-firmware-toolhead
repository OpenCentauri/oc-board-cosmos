#!/bin/sh
### BEGIN INIT INFO
# Provides:          klipper-firmware-toolhead
# Required-Start:    $local_fs $remote_fs $network
# Required-Stop:     $local_fs $remote_fs $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Start OpenCentauri firmware
### END INIT INFO

# OC-board: stock GPIO power/reset handling is unavailable.
# New plan needed for booting into Katapult on this host.

FIRMWARE="/usr/lib/firmware/klipper-toolhead.bin"
FIRMWARE_VERSION="/usr/lib/firmware/klipper-toolhead.bin.ver"
KATAPULT_DEPLOYER="/usr/lib/firmware/katapult-deployer-toolhead.bin"
INSTALLED_VERSION="/etc/toolhead.ver"
SERIALPORT="/dev/serial/by-path/platform-xhci-hcd.0.auto-usb-0:1.3:1.0"

update(){
    if flashtool -d "$SERIALPORT" -f "$FIRMWARE"; then
        cp "$FIRMWARE_VERSION" "$INSTALLED_VERSION" || exit 1
        sleep 3
        echo "Firmware flashed and version recorded."
    else
        echo "Firmware flash failed, version not updated."
        return 1
    fi
}

case "$1" in
    start)
        if [ ! -f /etc/mcu-flash-enable ]; then
            echo "MCU flashing is disabled; create /etc/mcu-flash-enable to enable it."
            exit 0
        fi
        if [ ! -e "$SERIALPORT" ]; then
            echo "Toolhead MCU is not present; skipping firmware flash."
            exit 0
        fi
        echo "Starting klipper-firmware-toolhead..."
        sleep 3

        if [ -e "$SERIALPORT" ]; then
            VENDOR=$(
                udevadm info -q property -n "$SERIALPORT" |
                sed -n 's/^ID_VENDOR=//p'
            )

            if [ "$VENDOR" = "ShenZhenCBD" ]; then
                echo "Detected Elegoo bootloader, resetting saved version..."
                rm -f "$INSTALLED_VERSION"
            fi
        fi

        if [ -f "$INSTALLED_VERSION" ] && [ "$(cat "$INSTALLED_VERSION")" = "$(cat "$FIRMWARE_VERSION")" ]; then
            echo "Firmware is already up to date."
            exit 0
        else
            echo "Firmware version mismatch or not installed, flashing firmware..."
            if update; then
                exit 0
            else
                echo "Attempting bootloader upgrade..."
                sleep 3
                if mcu-flasher --firmware "$KATAPULT_DEPLOYER" --no-wait "$SERIALPORT" --firmware-version 6.4.9; then
                    sleep 3
                    echo "Bootloader deployer flashed successfully, clearing installed version."
                    rm -f "$INSTALLED_VERSION"
                    update
                else
                    echo "Cannot update bootloader."
                    exit 1
                fi
            fi
        fi
        ;;
    stop)
        echo "Stopping klipper-firmware-toolhead..."
        ;;
    restart|force-reload)
        "$0" stop
        sleep 2
        "$0" start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac
