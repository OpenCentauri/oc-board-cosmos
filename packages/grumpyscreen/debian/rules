#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_build:
	$(MAKE) -C /upstream/grumpyscreen libhv.a
	$(MAKE) -C /upstream/grumpyscreen wpaclient
	$(MAKE) -C /upstream/grumpyscreen default \
		GUPPY_SMALL_SCREEN=true COSMOS=true MMU_BACKENDS=afc \
		LIBS="-lstdc++fs $(CURDIR)/build/lib/libhv.a $(CURDIR)/build/lib/wpaclient.a"

override_dh_auto_install:
	install -d debian/grumpyscreen/usr/bin
	install -m 0755 /upstream/grumpyscreen/build/bin/grumpyscreen debian/grumpyscreen/usr/bin/grumpyscreen
	install -d debian/grumpyscreen/etc/init.d
	install -m 0755 debian/grumpyscreen.init debian/grumpyscreen/etc/init.d/grumpyscreen
