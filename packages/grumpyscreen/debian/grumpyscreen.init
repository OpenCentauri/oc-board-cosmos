#!/bin/sh
### BEGIN INIT INFO
# Provides:          grumpyscreen
# Required-Start:    $remote_fs
# Required-Stop:     $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: GrumpyScreen
### END INIT INFO
case "$1" in
  start) start-stop-daemon --start --background --exec /usr/bin/grumpyscreen ;;
  stop) start-stop-daemon --stop --exec /usr/bin/grumpyscreen ;;
  *) exit 1 ;;
esac
