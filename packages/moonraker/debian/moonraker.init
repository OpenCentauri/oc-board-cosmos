#!/bin/sh
### BEGIN INIT INFO
# Provides:          moonraker
# Required-Start:    $remote_fs klipper
# Required-Stop:     $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Moonraker
### END INIT INFO
. /lib/lsb/init-functions
case "$1" in
  start) start-stop-daemon --start --background --exec /usr/bin/python3 -- /usr/share/moonraker/moonraker/moonraker.py ;;
  stop) start-stop-daemon --stop --name moonraker.py ;;
  *) exit 1 ;;
esac
