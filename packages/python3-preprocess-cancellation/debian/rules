#!/usr/bin/make -f

%:
	dh $@ --with python3 --buildsystem=none

override_dh_auto_clean:
	dh_clean

override_dh_auto_build:
	:

override_dh_auto_install:
	install -d debian/python3-preprocess-cancellation/usr/lib/python3/dist-packages
	install -m 0644 preprocess_cancellation.py debian/python3-preprocess-cancellation/usr/lib/python3/dist-packages/
