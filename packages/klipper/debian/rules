#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_build:
	cd /upstream/kalico/klippy/chelper && $(CC) -shared -fPIC -O2 -o c_helper.so \
		pyhelper.c serialqueue.c stepcompress.c steppersync.c itersolve.c \
		trapq.c pollreactor.c msgblock.c trdispatch.c kin_cartesian.c \
		kin_corexy.c kin_corexz.c kin_delta.c kin_deltesian.c kin_polar.c \
		kin_rotary_delta.c kin_winch.c kin_extruder.c kin_shaper.c kin_idex.c -lm

override_dh_auto_install:
	install -d debian/klipper/usr/share/klipper
	cp -a /upstream/kalico/klippy debian/klipper/usr/share/klipper/
	install -m 0755 /upstream/kalico/klippy/chelper/c_helper.so debian/klipper/usr/share/klipper/klippy/chelper/
	install -m 0644 /cosmos/meta-opencentauri/recipes-apps/klipper/files/canvas_rfid.py debian/klipper/usr/share/klipper/klippy/extras/
	install -m 0644 /cosmos/meta-opencentauri/recipes-apps/klipper/files/canvas_filament_sensor.py debian/klipper/usr/share/klipper/klippy/extras/
	install -d debian/klipper/usr/share/klipper/config
	install -d debian/klipper/usr/share/klipper/docs
