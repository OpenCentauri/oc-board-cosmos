#!/bin/sh
### BEGIN INIT INFO
# Provides:          klipper
# Required-Start:    $remote_fs $syslog
# Required-Stop:     $remote_fs $syslog
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Kalico klippy
### END INIT INFO
DAEMON=/usr/bin/python3
ARGS=/usr/share/klipper/klippy/klippy.py
PIDFILE=/run/klipper.pid
. /lib/lsb/init-functions
case "$1" in
  start) start-stop-daemon --start --background --make-pidfile --pidfile "$PIDFILE" --exec "$DAEMON" -- $ARGS ;;
  stop) start-stop-daemon --stop --pidfile "$PIDFILE" ;;
  restart) "$0" stop; "$0" start ;;
  *) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
